#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/zigbeemq

wait_tty() {
	local dev="$1"
	local n=0
	while [ ! -e "$dev" ] && [ "$n" -lt 20 ]; do
		sleep 1
		n=$((n + 1))
	done
}

start_service() {
	config_load zigbeemq

	local port listen data mqtt mqtt_base
	config_get port main port /dev/ttyUSB0
	config_get listen main listen 0.0.0.0:8080
	config_get data main data /etc/zigbeemq
	config_get mqtt main mqtt 'tcp://bb:1883'
	config_get mqtt_base main mqtt_base zigbee2mqtt

	mkdir -p "$data"
	wait_tty "$port"

	procd_open_instance
	procd_set_param command "$PROG" \
		-port "$port" \
		-listen "$listen" \
		-data "$data" \
		-mqtt "$mqtt" \
		-mqtt-base "$mqtt_base"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/zigbeemq
	procd_close_instance
}
